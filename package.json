{
  "name": "hardscope",
  "productName": "HardScope",
  "version": "1.7.0",
  "description": "Analizador de hardware y cuellos de botella para PC: compara placa madre, tarjeta de video, CPU, RAM y discos, y da consejos de mejora.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/engine.test.js test/fixtures.test.js test/data.test.js test/catalog.test.js",
    "validate": "node scripts/validate-data.js",
    "fixture": "node scripts/capture-fixture.js",
    "format-data": "node scripts/format-data.js",
    "build-manifest": "node scripts/build-manifest.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "keywords": ["hardware", "bottleneck", "cuello de botella", "pc", "gpu", "motherboard", "electron"],
  "author": "HardScope",
  "license": "MIT",
  "type": "commonjs",
  "hardscope": {
    "repo": "tlion2k/HardScope"
  },
  "build": {
    "appId": "com.hardscope.app",
    "productName": "HardScope",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "asarUnpack": ["src/main/*.ps1"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HardScope",
      "artifactName": "HardScope-Setup.exe"
    },
    "portable": { "artifactName": "HardScope-Portable.exe" }
  },
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
